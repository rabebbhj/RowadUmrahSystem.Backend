@model RowadUmrahSystem.Web.Models.Traveler

@{
    ViewData["Title"] = "تسجيل مسافر جديد";
}

<div class="page-card">

    <div class="d-flex flex-wrap justify-content-between align-items-center mb-4">
        <div>
            <h1 class="page-title mb-1">تسجيل مسافر جديد</h1>
            <p class="text-muted mb-0">ارفع صورة الجواز، اقرأ البيانات تلقائياً، ثم راجع وعدّل قبل الحفظ.</p>
        </div>

        <a asp-action="Index" class="btn btn-outline-secondary">
            رجوع
        </a>
    </div>

    <form asp-action="Create"
          asp-controller="Travelers"
          method="post"
          enctype="multipart/form-data">

        <input type="hidden" asp-for="PassportImagePath" />

        <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

        <div class="row">

            <div class="col-lg-4 mb-4">
                <div class="page-card h-100">
                    <h4 class="section-title">صورة الجواز</h4>

                    <div class="mb-3">
                        <label class="form-label">رفع صورة الجواز</label>
                        <input type="file"
                               name="passportImage"
                               class="form-control"
                               accept=".jpg,.jpeg,.png,.webp" />
                    </div>

                    <button type="submit"
                            formaction="/Travelers/ReadPassport"
                            formmethod="post"
                            formnovalidate
                            class="btn btn-outline-gold w-100 mb-3">
                        قراءة بيانات الجواز
                    </button>

                    @if (!string.IsNullOrEmpty(Model.PassportImagePath))
                    {
                        <img src="@Model.PassportImagePath"
                             class="img-fluid rounded border"
                             alt="صورة الجواز" />
                    }
                    else
                    {
                        <div class="alert alert-info mb-0">
                            ارفع صورة الجواز ليتم عرضها هنا بعد القراءة.
                        </div>
                    }
                </div>
            </div>

            <div class="col-lg-8 mb-4">
                <div class="page-card h-100">
                    <h4 class="section-title">بيانات المسافر</h4>

                    <div class="row">

                        <div class="col-md-6 mb-3">
                            <label class="form-label">رقم الجواز</label>
                            <input asp-for="PassportNumber" class="form-control" />
                            <span asp-validation-for="PassportNumber" class="text-danger"></span>
                        </div>

                        <div class="col-md-6 mb-3">
                            <label class="form-label">الاسم الكامل</label>
                            <input asp-for="FullName" class="form-control" />
                        </div>

                        <div class="col-md-6 mb-3">
                            <label class="form-label">الجنسية</label>
                            <input asp-for="Nationality" class="form-control" />
                        </div>

                        <div class="col-md-6 mb-3">
                            <label class="form-label">الجنس</label>
                            <select asp-for="Gender" class="form-select">
                                <option value="">اختر الجنس</option>
                                <option value="M">ذكر</option>
                                <option value="F">أنثى</option>
                            </select>
                        </div>

                        <div class="col-md-6 mb-3">
                            <label class="form-label">تاريخ الميلاد</label>
                            <input asp-for="DateOfBirth" type="date" class="form-control" />
                        </div>

                        <div class="col-md-6 mb-3">
                            <label class="form-label">تاريخ انتهاء الجواز</label>
                            <input asp-for="PassportExpiryDate" type="date" class="form-control" />
                        </div>

                        <div class="col-md-6 mb-3">
                            <label class="form-label">رقم الهاتف</label>
                            <input asp-for="PhoneNumber" class="form-control" />
                        </div>

                        <div class="col-md-6 mb-3">
                            <label class="form-label">الإيميل</label>
                            <input asp-for="Email" class="form-control" />
                        </div>

                        <div class="col-12 mb-3">
                            <label class="form-label">ملاحظات</label>
                            <textarea asp-for="Notes"
                                      class="form-control"
                                      rows="4"
                                      placeholder="أي ملاحظات إضافية عن المسافر..."></textarea>
                        </div>

                    </div>
                </div>
            </div>

        </div>

        <div class="page-card">
            <div class="d-flex flex-wrap justify-content-between align-items-center">
                <div>
                    <h5 class="mb-1">تأكيد الحفظ</h5>
                    <small class="text-muted">
                        تأكد من مراجعة بيانات OCR قبل حفظ المسافر في قاعدة البيانات.
                    </small>
                </div>

                <div class="action-bar mb-0">
                    <button type="submit" class="btn btn-gold">
                        حفظ المسافر
                    </button>

                    <a asp-action="Index" class="btn btn-outline-secondary">
                        إلغاء
                    </a>
                </div>
            </div>
        </div>

    </form>

</div>

@section Scripts
{
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}