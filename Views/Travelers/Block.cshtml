@model RowadUmrahSystem.Web.Models.Traveler

@{
    ViewData["Title"] = "حظر المسافر";
}

<div class="page-card">

    <div class="d-flex justify-content-between align-items-center mb-4">

        <div>
            <h1 class="page-title mb-1">حظر المسافر</h1>

            <p class="text-muted mb-0">
                سيتم منع هذا المسافر من التسجيل أو إنشاء رحلة جديدة مستقبلاً.
            </p>
        </div>

        <a asp-action="Details"
           asp-route-id="@Model.Id"
           class="btn btn-outline-secondary">
            رجوع
        </a>

    </div>

    <div class="alert alert-warning">
        <strong>تنبيه مهم:</strong>
        عند حظر المسافر سيقوم النظام بمنع تسجيله مرة أخرى عند قراءة الجواز أو محاولة إنشاء رحلة جديدة له.
    </div>

    <div class="row">

        <div class="col-lg-4 mb-4">

            <div class="page-card h-100">

                @if (!string.IsNullOrEmpty(Model.PassportImagePath))
                {
                    <img src="@Model.PassportImagePath"
                         class="img-fluid rounded border"
                         alt="صورة الجواز" />
                }
                else
                {
                    <div class="alert alert-info mb-0">
                        لا توجد صورة جواز محفوظة.
                    </div>
                }

            </div>

        </div>

        <div class="col-lg-8 mb-4">

            <div class="page-card h-100">

                <h4 class="section-title">بيانات المسافر</h4>

                <div class="row">

                    <div class="col-md-6 mb-3">
                        <small class="text-muted">رقم الجواز</small>
                        <div>
                            <strong>@Model.PassportNumber</strong>
                        </div>
                    </div>

                    <div class="col-md-6 mb-3">
                        <small class="text-muted">الاسم الكامل</small>
                        <div>
                            <strong>@Model.FullName</strong>
                        </div>
                    </div>

                    <div class="col-md-6 mb-3">
                        <small class="text-muted">الجنسية</small>
                        <div>@Model.Nationality</div>
                    </div>

                    <div class="col-md-6 mb-3">
                        <small class="text-muted">عدد العمرات</small>
                        <div>@Model.Trips.Count</div>
                    </div>

                </div>

            </div>

        </div>

    </div>

    <div class="page-card border-danger">

        <h4 class="text-danger mb-3">
            سبب الحظر
        </h4>

        <form asp-action="Block" method="post">

            <input type="hidden" name="id" value="@Model.Id" />

            <div class="mb-3">

                <label class="form-label">
                    اكتب سبب الحظر بالتفصيل
                </label>

                <textarea name="blockReason"
                          class="form-control"
                          rows="6"
                          required
                          placeholder="مثال: تسبب بمشاكل أثناء الرحلة، مخالفة تعليمات الحملة، إساءة للمرشد، ..."></textarea>

            </div>

            <div class="action-bar">

                <button type="submit"
                        class="btn btn-danger">
                    تأكيد الحظر
                </button>

                <a asp-action="Details"
                   asp-route-id="@Model.Id"
                   class="btn btn-outline-secondary">
                    إلغاء
                </a>

            </div>

        </form>

    </div>

</div>