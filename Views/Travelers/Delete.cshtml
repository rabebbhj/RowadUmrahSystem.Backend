@model RowadUmrahSystem.Web.Models.Traveler

@{
    ViewData["Title"] = "أرشفة المسافر";
}

<div class="page-card">

    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h1 class="page-title mb-1">أرشفة المسافر</h1>
            <p class="text-muted mb-0">
                سيتم نقل المسافر إلى الأرشيف بدلاً من حذفه نهائياً.
            </p>
        </div>

        <a asp-action="Details"
           asp-route-id="@Model.Id"
           class="btn btn-outline-secondary">
            رجوع
        </a>
    </div>

    <div class="alert alert-warning">
        <strong>تنبيه:</strong>
        لن يتم حذف بيانات المسافر نهائياً، وإنما سيتم أرشفته ويمكن استعادته لاحقاً.
    </div>

    <div class="row">

        <div class="col-lg-4 mb-4">

            <div class="page-card h-100">

                @if (!string.IsNullOrEmpty(Model.PassportImagePath))
                {
                    <img src="@Model.PassportImagePath"
                         class="img-fluid rounded border"
                         alt="صورة الجواز" />
                }
                else
                {
                    <div class="alert alert-info mb-0">
                        لا توجد صورة جواز.
                    </div>
                }

            </div>

        </div>

        <div class="col-lg-8 mb-4">

            <div class="page-card h-100">

                <h4 class="section-title">بيانات المسافر</h4>

                <div class="row">

                    <div class="col-md-6 mb-3">
                        <small class="text-muted">رقم الجواز</small>
                        <div>
                            <strong>@Model.PassportNumber</strong>
                        </div>
                    </div>

                    <div class="col-md-6 mb-3">
                        <small class="text-muted">الاسم الكامل</small>
                        <div>
                            <strong>@Model.FullName</strong>
                        </div>
                    </div>

                    <div class="col-md-6 mb-3">
                        <small class="text-muted">الجنسية</small>
                        <div>@Model.Nationality</div>
                    </div>

                    <div class="col-md-6 mb-3">
                        <small class="text-muted">عدد العمرات</small>
                        <div>@Model.Trips.Count</div>
                    </div>

                </div>

            </div>

        </div>

    </div>

    <div class="page-card border-danger">

        <h4 class="text-danger mb-3">
            تأكيد الأرشفة
        </h4>

        <p class="text-muted">
            سيتم نقل المسافر إلى قسم الأرشيف مع الاحتفاظ بكامل:
        </p>

        <ul>
            <li>بيانات المسافر</li>
            <li>الرحلات</li>
            <li>الوثائق</li>
            <li>سجل العمليات</li>
        </ul>

        <form asp-action="Delete" method="post">

            <input type="hidden" asp-for="Id" />

            <div class="action-bar">

                <button type="submit" class="btn btn-danger">
                    تأكيد الأرشفة
                </button>

                <a asp-action="Details"
                   asp-route-id="@Model.Id"
                   class="btn btn-outline-secondary">
                    إلغاء
                </a>

            </div>

        </form>

    </div>

</div>