@model RowadUmrahSystem.Web.Models.Traveler

@{
    ViewData["Title"] = "تعديل بيانات المسافر";
}

<div class="page-card">

    <div class="d-flex flex-wrap justify-content-between align-items-center mb-4">
        <div>
            <h1 class="page-title mb-1">تعديل بيانات المسافر</h1>
            <p class="text-muted mb-0">
                تعديل بيانات: <strong>@Model.FullName</strong>
            </p>
        </div>

        <div class="action-bar mb-0">
            <a asp-action="Details"
               asp-route-id="@Model.Id"
               class="btn btn-outline-gold">
                عرض الملف
            </a>

            <a asp-action="Index"
               class="btn btn-outline-secondary">
                رجوع
            </a>
        </div>
    </div>

    <form asp-action="Edit" method="post">

        <input type="hidden" asp-for="Id" />
        <input type="hidden" asp-for="CreatedAt" />
        <input type="hidden" asp-for="PassportImagePath" />

        <div class="row">

            <div class="col-lg-4 mb-4">
                <div class="page-card h-100">
                    <h4 class="section-title">صورة الجواز الحالية</h4>

                    @if (!string.IsNullOrEmpty(Model.PassportImagePath))
                    {
                        <img src="@Model.PassportImagePath"
                             class="img-fluid rounded border"
                             alt="صورة الجواز" />
                    }
                    else
                    {
                        <div class="alert alert-info mb-0">
                            لا توجد صورة جواز محفوظة.
                        </div>
                    }
                </div>
            </div>

            <div class="col-lg-8 mb-4">
                <div class="page-card h-100">
                    <h4 class="section-title">البيانات الأساسية</h4>

                    <div class="row">

                        <div class="col-md-6 mb-3">
                            <label class="form-label">رقم الجواز</label>
                            <input asp-for="PassportNumber" class="form-control" />
                        </div>

                        <div class="col-md-6 mb-3">
                            <label class="form-label">الاسم الكامل</label>
                            <input asp-for="FullName" class="form-control" />
                        </div>

                        <div class="col-md-6 mb-3">
                            <label class="form-label">الجنسية</label>
                            <input asp-for="Nationality" class="form-control" />
                        </div>

                        <div class="col-md-6 mb-3">
                            <label class="form-label">الجنس</label>
                            <select asp-for="Gender" class="form-select">
                                <option value="">اختر الجنس</option>
                                <option value="M">ذكر</option>
                                <option value="F">أنثى</option>
                            </select>
                        </div>

                        <div class="col-md-6 mb-3">
                            <label class="form-label">تاريخ الميلاد</label>
                            <input asp-for="DateOfBirth" type="date" class="form-control" />
                        </div>

                        <div class="col-md-6 mb-3">
                            <label class="form-label">تاريخ انتهاء الجواز</label>
                            <input asp-for="PassportExpiryDate" type="date" class="form-control" />
                        </div>

                        <div class="col-md-6 mb-3">
                            <label class="form-label">رقم الهاتف</label>
                            <input asp-for="PhoneNumber" class="form-control" />
                        </div>

                        <div class="col-md-6 mb-3">
                            <label class="form-label">الإيميل</label>
                            <input asp-for="Email" class="form-control" />
                        </div>

                        <div class="col-12 mb-3">
                            <label class="form-label">ملاحظات</label>
                            <textarea asp-for="Notes"
                                      class="form-control"
                                      rows="4"></textarea>
                        </div>

                    </div>
                </div>
            </div>

        </div>

        <div class="page-card mb-4">
            <h4 class="section-title">الحالة</h4>

            <div class="form-check">
                <input asp-for="IsBlocked" class="form-check-input" />
                <label class="form-check-label">
                    المسافر محظور
                </label>
            </div>

            <small class="text-muted d-block mt-2">
                يفضّل استخدام صفحة الحظر الرسمية عند وجود سبب حظر واضح حتى يتم تسجيل السبب في سجل العمليات.
            </small>
        </div>

        <div class="page-card">
            <div class="d-flex flex-wrap justify-content-between align-items-center">
                <div>
                    <h5 class="mb-1">حفظ التعديلات</h5>
                    <small class="text-muted">
                        سيتم تحديث بيانات المسافر في قاعدة البيانات.
                    </small>
                </div>

                <div class="action-bar mb-0">
                    <button type="submit" class="btn btn-gold">
                        حفظ التعديل
                    </button>

                    <a asp-action="Details"
                       asp-route-id="@Model.Id"
                       class="btn btn-outline-secondary">
                        إلغاء
                    </a>
                </div>
            </div>
        </div>

    </form>

</div>